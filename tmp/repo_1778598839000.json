    "com.northstarlabs.fantag": {
      "metadata": {
        "added": 1777789622000,
        "categories": [
          "Sports & Health"
        ],
        "lastUpdated": 1777789622000,
        "license": "proprietary",
        "authorName": "Northstar Labs",
        "authorWebSite": "https://github.com/northstar-works",
        "name": {
          "en-US": "FANTAG"
        },
        "summary": {
          "en-US": "Fantasy baseball roster tracker for your self-hosted FANTAG server"
        },
        "description": {
          "en-US": "FANTAG is a personal fantasy baseball roster management tool that connects\nto your self-hosted FANTAG server (FastAPI + React backend).\n\nFeatures:\n* Live lineup status from MLB Stats API and RotoWire\n* Roster and watch list management\n* ESPN Fantasy sync (private leagues via session cookies)\n* Player position history and usage pattern engine\n* Screenshot roster import via Claude Vision OCR\n* Backup and restore\n* Configurable server URL (supports local network or DDNS)\n\nThis app is a native Android WebView wrapper for the FANTAG web interface.\nRequires a running FANTAG server instance on your home network."
        },
        "preferredSigner": "ec229ffd349897f965356d5b6733169cb59c5202885c0813021c1e3f261bade9"
      },
      "versions": {
